# Copy to .env.local (apps/web) or export in your shell. Everything is optional in development.

# --- Security -----------------------------------------------------------
# 32+ random characters. Encrypts saved designs and signs download links.
# In development a random secret is generated into .data/secret when unset.
APP_SECRET=
# Token for the /admin area. The admin area is disabled when unset.
ADMIN_TOKEN=

# --- Storage ------------------------------------------------------------
# Where caches, exports and the embedded dev database live.
MAPLOOM_DATA_DIR=.data
# Postgres connection string. Unset = embedded PGlite database in MAPLOOM_DATA_DIR.
DATABASE_URL=

# --- Map data (OpenStreetMap ecosystem; all swappable) -------------------
# OpenMapTiles-schema TileJSON. Default: OpenFreeMap.
MAPLOOM_TILEJSON_URL=https://tiles.openfreemap.org/planet
# Geocoders. Public instances are for development only — see docs/architecture/MAP_DATA.md
MAPLOOM_PHOTON_URL=https://photon.komoot.io
MAPLOOM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Sent as User-Agent to data providers (their policies require a contact).
MAPLOOM_USER_AGENT=maploom-dev/0.1

# --- Limits -------------------------------------------------------------
# Largest PNG the exporter will produce, in megapixels (4x6 ft @ 300dpi = 311).
MAPLOOM_MAX_EXPORT_MP=320
# Set to 0 when a separate `npm run worker` process handles jobs (needs DATABASE_URL).
MAPLOOM_INLINE_WORKER=1

# Behind a corporate/sandbox HTTPS proxy, make Node's fetch honour HTTPS_PROXY:
# NODE_USE_ENV_PROXY=1

# Offline demo / e2e: serve map data from saved tiles instead of the network.
# MAPLOOM_FIXTURE_TILES=tests/fixtures/tiles
