{
  "name": "maploom",
  "private": true,
  "version": "0.1.0",
  "description": "Maploom (working name) — turn real places into personalized illustrated maps.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @maploom/web",
    "build": "npm run build -w @maploom/web",
    "start": "npm run start -w @maploom/web",
    "worker": "npm run start -w @maploom/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @maploom/web",
    "e2e": "playwright test",
    "demo:render": "tsx scripts/render-demo.ts",
    "fixtures:refresh": "tsx scripts/refresh-fixtures.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
